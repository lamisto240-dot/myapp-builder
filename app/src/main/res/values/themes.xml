<resources>
    <style name="Theme.Calculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#00E676</item>
        <item name="colorPrimaryVariant">#00C853</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="android:statusBarColor">#121212</item>
        <item name="android:windowBackground">#121212</item>
    </style>

    <style name="CalcButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">#212121</item>
        <item name="cornerRadius">16dp</item>
        <item name="insetTop">0dp</item>
        <item name="insetBottom">0dp</item>
    </style>

    <style name="CalcButton.Function" parent="CalcButton">
        <item name="backgroundTint">#333333</item>
        <item name="android:textColor">#00E676</item>
    </style>

    <style name="CalcButton.Operator" parent="CalcButton">
        <item name="backgroundTint">#2E3B32</item>
        <item name="android:textColor">#00E676</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcButton.Equal" parent="CalcButton">
        <item name="backgroundTint">#00E676</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>